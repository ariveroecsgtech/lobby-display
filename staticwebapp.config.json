{
  "platform": { "apiRuntime": "node:20" },
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/login", "redirect": "/.auth/login/aad?post_login_redirect_uri=/manage/" },
    { "route": "/logout", "redirect": "/.auth/logout?post_logout_redirect_uri=/" },
    { "route": "/manage", "allowedRoles": ["manager", "admin"] },
    { "route": "/manage/*", "allowedRoles": ["manager", "admin"] },
    { "route": "/api/manage/*", "allowedRoles": ["manager", "admin"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer", "statusCode": 302 },
    "403": { "rewrite": "/denied.html" }
  },
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/api/*", "/manage/*", "/denied.html"] },
  "globalHeaders": { "Cache-Control": "no-cache" }
}
